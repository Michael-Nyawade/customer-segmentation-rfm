models/*

# Keep the models directory structure
!models/.gitkeep

# Generated figures and visualizations
reports/figures/*

# Keep the figures directory structure
!reports/figures/.gitkeep

# IDE / Editor settings
.vscode/
.idea/

# Operating system files
.DS_Store
Thumbs.db
